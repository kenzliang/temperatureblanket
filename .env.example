# Supabase — service role only (no anon key needed; all DB access is server-side)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Basic Auth — browser visitors see a native login dialog
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=changeme

# Cron job protection — Vercel sends this header automatically for cron jobs.
# Do NOT set TZ here; Vercel reserves that env var.
CRON_SECRET=a-long-random-string-here

# Precipitation threshold in inches (>0.05" = measurable rain)
PRECIP_THRESHOLD_IN=0.05
